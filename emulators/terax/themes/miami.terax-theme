{
  "id": "miami",
  "name": "Miami",
  "author": "xscriptor-terax-themes",
  "description": "Pure black with synthwave neon — cyan, magenta, and hot pink. Retro-futuristic.",
  "editorTheme": { "dark": "atomone" },
